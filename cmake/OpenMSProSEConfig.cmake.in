@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(OpenMS @OpenMS_VERSION@ EXACT CONFIG)
if(NOT "${OpenMS_SOURCE_REVISION}" STREQUAL "@OpenMS_SOURCE_REVISION@")
  message(FATAL_ERROR "OpenMSProSE requires OpenMS core commit @OpenMS_SOURCE_REVISION@")
endif()
set(OpenMSProSE_VERSION "@PROJECT_VERSION@")
set(OpenMSProSE_SOURCE_REVISION "@OpenMSProSE_SOURCE_REVISION@")
set(OpenMSProSE_SOURCE_DIRTY "@OpenMSProSE_SOURCE_DIRTY@")
set(OpenMSProSE_CORE_SOURCE_REVISION "@OpenMS_SOURCE_REVISION@")
set(OpenMSProSE_CORE_SOURCE_DIRTY "@OpenMS_SOURCE_DIRTY@")
if(NOT TARGET OpenMS::ProSE)
  include("${CMAKE_CURRENT_LIST_DIR}/OpenMSProSETargets.cmake")
endif()
check_required_components(OpenMSProSE)
